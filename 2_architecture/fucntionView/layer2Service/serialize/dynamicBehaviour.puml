@startuml
title Serialize (Response Formatter) - Dynamic Behaviour

participant "Central App Controller" as CAC
participant "Serialize" as SER
participant "Serial Driver" as SD

== Format ADC Read Response ==
CAC -> SER : FormatResponse(ADC_READ_RESPONSE, {channel:1, value:2048})
SER -> SER : DetermineFormat() -> ASCII
SER -> SER : BuildResponseString()
SER -> SER : response = "ADC:CH1:VALUE:2048"
SER -> SER : AddDelimiters(response)
SER -> SD : Transmit("ADC:CH1:VALUE:2048\\r\\n")

== Format I2C Read Response (Hex Format) ==
CAC -> SER : FormatResponse(I2C_READ_RESPONSE, {addr:0x50, data:[0xAA, 0xBB, 0xCC]})
SER -> SER : DetermineFormat() -> HEX
SER -> SER : ConvertBytesToHex([0xAA, 0xBB, 0xCC])
SER -> SER : response = "I2C:READ:0x50:DATA:AA BB CC"
SER -> SER : AddDelimiters(response)
SER -> SD : Transmit("I2C:READ:0x50:DATA:AA BB CC\\r\\n")

== Format Error Response ==
CAC -> SER : FormatError(ERROR_TIMEOUT, "I2C timeout")
SER -> SER : BuildErrorString()
SER -> SER : error = "ERROR:TIMEOUT:I2C timeout"
SER -> SER : AddDelimiters(error)
SER -> SD : Transmit("ERROR:TIMEOUT:I2C timeout\\r\\n")

== Format Simple Acknowledgment ==
CAC -> SER : FormatAck(SUCCESS)
SER -> SER : ack = "OK"
SER -> SER : AddDelimiters(ack)
SER -> SD : Transmit("OK\\r\\n")

@enduml
