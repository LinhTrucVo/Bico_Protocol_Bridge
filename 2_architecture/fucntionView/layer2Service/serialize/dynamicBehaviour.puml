@startuml
title Serialize (UDS Response Builder) - Dynamic Behaviour

participant "Central App Controller" as CAC
participant "Serialize" as SER
participant "Serial Driver" as SD

== SID 0x22 ReadDataByIdentifier Response ==
CAC -> SER : BuildResponse(sid=0x22, did=0x1001, data=[0x04,0x00])
SER -> SER : responseSID = 0x22 + 0x40 = 0x62
SER -> SER : Encode DID big-endian: [0x10, 0x01]
SER -> SER : frame = [0x62, 0x10, 0x01, 0x04, 0x00]
SER -> SD : Transmit(frame)

== SID 0x2E WriteDataByIdentifier Response ==
CAC -> SER : BuildResponse(sid=0x2E, did=0x1001)
SER -> SER : responseSID = 0x2E + 0x40 = 0x6E
SER -> SER : Encode DID big-endian: [0x10, 0x01]
SER -> SER : frame = [0x6E, 0x10, 0x01]
SER -> SD : Transmit(frame)

== SID 0x31 RoutineControl Response ==
CAC -> SER : BuildResponse(sid=0x31, routineControlType=0x01, routineID=0x0200, status=0x00)
SER -> SER : responseSID = 0x31 + 0x40 = 0x71
SER -> SER : Encode routineID big-endian: [0x02, 0x00]
SER -> SER : frame = [0x71, 0x01, 0x02, 0x00, 0x00]
SER -> SD : Transmit(frame)

== Negative Response ==
CAC -> SER : BuildNegativeResponse(requestSID=0x22, nrc=0x31)
SER -> SER : frame = [0x7F, 0x22, 0x31]
SER -> SD : Transmit(frame)

@enduml