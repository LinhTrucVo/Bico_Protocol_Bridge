@startuml

title Serialize (UDS Response Builder) - Static View

package "Serialize" {
    [Response Encoder] as encoder
    note right of encoder
        - Encodes response SID: requestSID + 0x40
        - Encodes DID or RoutineID (2 bytes, big-endian)
        - Appends data payload for SID 0x22
    end note

    [Negative Response Builder] as negBuilder
    note right of negBuilder
        - Builds frame: [0x7F, requestSID, NRC]
        - NRC codes per ISO 14229
    end note
}

[Central App Controller] as controller
[Serial Driver] as serialDriver

controller --> encoder : UDS_Response{sid, did/routineID, data}
controller --> negBuilder : UDS_Error{requestSID, nrc}
encoder --> serialDriver : UDS positive response frame (bytes)
negBuilder --> serialDriver : UDS negative response frame (bytes)

@enduml