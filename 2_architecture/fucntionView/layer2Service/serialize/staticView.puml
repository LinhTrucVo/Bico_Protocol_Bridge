@startuml

title Serialize (Response Formatter) - Static View

package "Serialize" {
    [Response Builder] as builder
    note right of builder
        - Converts data structures to text format
        - Example: {channel:1, value:2048} 
          → "ADC:CH1:VALUE:2048"
        - Serializes raw data without conversion
    end note
    
    [Format Handler] as format
    note right of format
        - Handles different output formats
        - ASCII text, HEX strings, binary
        - No physical unit conversion
    end note
    
    [Message Framing] as framing
    note right of framing
        - Adds delimiters and terminators
        - Example: "OK" → "OK\\r\\n"
    end note
}

[Central App Controller] as controller
[Serial Driver] as serialDriver

controller --> builder : Raw data structure
builder --> format : Format serialization
format --> framing : Apply delimiters
framing --> serialDriver : Complete serial stream

@enduml
