@startuml

title Data Conversion Service - Static View

package "Data Conversion Service" {
    [ADC to Engineering] as adc2eng
    [Format Converter] as format
    [Scaling] as scale
    [Endian Converter] as endian
    [Unit Converter] as units
}

[Calibration Service] as calibrationService
[Config Service] as configService

adc2eng --> calibrationService : Apply calibration
adc2eng --> configService : Get voltage range, resolution
scale --> configService : Get scaling factors

@enduml
