@startuml
title Calibration Service - Information Flow

package "System Startup Flow" {
    component "Application" as APP1
    component "Calibration Service" as CS1
    component "NVM Driver" as NVM1
    
    APP1 -down-> CS1 : Load_Calibration()
    CS1 -down-> NVM1 : NVM_Read(cal_addr)
    NVM1 -up-> CS1 : Calibration Data (Valid or Invalid)
    CS1 -down-> CS1 : Validate / Load_Factory_Defaults()
    CS1 -up-> APP1 : Calibration Loaded / Default Config
}

package "Apply Calibration Flow" {
    component "ADC Driver" as ADC2
    component "Application" as APP2
    component "Calibration Service" as CS2
    
    ADC2 -down-> APP2 : raw_adc_value
    APP2 -down-> CS2 : Apply_Calibration(channel, raw_value)
    CS2 -down-> CS2 : Validate_Parameters()
    CS2 -down-> CS2 : corrected = (raw - offset) * gain
    CS2 -up-> APP2 : corrected_value
}

package "Perform Calibration Flow" {
    component "Application" as APP3
    component "Calibration Service" as CS3
    component "NVM Driver" as NVM3
    
    APP3 -down-> CS3 : Start_Calibration(channel, type)
    CS3 -down-> CS3 : Execute_Calibration_Procedure()
    CS3 -down-> CS3 : Calculate_Offset_Gain()
    CS3 -down-> NVM3 : NVM_Write(cal_addr, cal_data)
    NVM3 -up-> CS3 : Success / Error
    CS3 -up-> APP3 : Calibration_Complete
}

@enduml