@startuml
title Calibration Service - Dynamic Behaviour

participant "Application" as APP
participant "ADC Driver" as ADC
participant "Calibration Service" as CAL
participant "NVM Driver" as NVM

== Initialization ==
APP -> CAL : CalibrationService_Init()
CAL -> NVM : NVM_Read(CALIBRATION_ADDRESS, buffer, size)
alt Calibration Valid
    NVM --> CAL : calibration_data
    CAL -> CAL : ValidateCalibration(data)
    CAL --> APP : CALIBRATION_LOADED
else Invalid or Empty
    CAL -> CAL : LoadFactoryDefaults()
    CAL --> APP : FACTORY_CALIBRATION
end

== Apply Calibration to ADC Value ==
APP -> ADC : Read_ADC(channel)
ADC --> APP : raw_adc_value
APP -> CAL : ApplyCalibration(channel, raw_adc_value)
CAL -> CAL : Get offset and gain for channel
CAL -> CAL : calibrated_value = (raw_adc_value - offset) * gain
CAL --> APP : calibrated_value

== Two-Point Calibration Procedure ==
APP -> CAL : StartCalibration(channel, raw_low, ref_low, raw_high, ref_high)
CAL -> CAL : Calculate: offset = raw_low - ref_low
CAL -> CAL : Calculate: gain = (ref_high - ref_low) / (raw_high - raw_low)
CAL -> CAL : ValidateCalibration(offset, gain)

alt Valid Calibration
    CAL -> NVM : NVM_Write(CAL_ADDRESS, calibration, size)
    NVM --> CAL : SUCCESS
    CAL --> APP : CALIBRATION_COMPLETE
else Invalid
    CAL --> APP : CALIBRATION_ERROR
end

@enduml
