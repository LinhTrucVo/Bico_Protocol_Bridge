@startuml

title Calibration Service - Static View

package "Calibration Service" {
    [Load Calibration] as load
    [Save Calibration] as save
    [Apply Calibration] as apply
    [Calibration Procedure] as procedure
    [Validate Calibration] as validator
    [Factory Defaults] as defaults
}

[ADC Driver] as adcDriver
[NVM Driver] as nvmDriver
[Config Service] as configService

load --> nvmDriver : Read calibration
save --> nvmDriver : Write calibration
load ..> defaults : Fallback values
apply <-- adcDriver : raw_adc_value
apply ..> configService : Get channel config

@enduml
