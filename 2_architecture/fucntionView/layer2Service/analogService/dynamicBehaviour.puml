@startuml
title Analog Service - Dynamic Behaviour

participant "Central App Controller" as CC
participant "Analog Service" as AA
participant "ADC Driver" as ADC
participant "Config Service" as CS

== Initialization ==
CC -> AA : AnalogService_Init()
AA -> CS : ConfigService_GetAdcResolution()
CS --> AA : resolution=12
AA -> CS : ConfigService_GetAdcSampleRate()
CS --> AA : sampleRate=1000
AA -> AA : InitializeChannels(resolution, sampleRate)
loop For each configured channel
    AA -> ADC : ADC_ConfigChannel(ch, resolution, rate)
    ADC --> AA : SUCCESS
end
AA --> CC : INIT_SUCCESS

== Read ADC ==
CC -> AA : AnalogService_ReadAdc(channel=1)
AA -> ADC : ADC_StartSingle(ch=1)
ADC -> ADC : Perform conversion
ADC -> AA : ConversionComplete_Callback(raw_value=2048)
alt Conversion OK
    AA --> CC : raw_value=2048
else Conversion Error
    AA --> CC : ERROR_CONVERSION
end

@enduml