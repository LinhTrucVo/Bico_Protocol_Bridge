@startuml
title Configuration Service - Dynamic Behaviour

participant "Central App Controller" as CAC
participant "Config Service" as CS
participant "NVM Driver" as NVM

== System Initialization ==
CAC -> CS : ConfigService_Init()
CS -> NVM : NVM_Read(CONFIG_ADDRESS, buffer, size)
alt NVM data valid
    NVM --> CS : JSON config data
    CS -> CS : ParseJson(data)
    CS -> CS : ValidateAll()
    CS --> CAC : CONFIG_LOADED
else NVM empty or corrupt
    CS -> CS : LoadDefaults()
    CS --> CAC : DEFAULT_CONFIG_LOADED
end

== Read Parameter ==
CAC -> CS : ConfigService_GetAdcSampleRate()
CS -> CS : ReadFromInternalStore(ADC_SAMPLE_RATE)
CS --> CAC : sampleRate=1000

== Write Parameter (Valid) ==
CAC -> CS : ConfigService_SetAdcSampleRate(2000)
CS -> CS : ValidateRange(2000, min=100, max=10000) -> OK
CS -> CS : UpdateInternalStore(ADC_SAMPLE_RATE, 2000)
CS -> NVM : NVM_Write(CONFIG_ADDRESS, JSON, size)
NVM --> CS : SUCCESS
CS --> CAC : OK

== Write Parameter (Invalid) ==
CAC -> CS : ConfigService_SetAdcSampleRate(99999)
CS -> CS : ValidateRange(99999, min=100, max=10000) -> FAIL
CS --> CAC : INVALID_PARAM

== Save All to NVM ==
CAC -> CS : ConfigService_SaveAll()
CS -> CS : SerializeToJson()
CS -> NVM : NVM_Write(CONFIG_ADDRESS, JSON, size)
NVM --> CS : SUCCESS
CS --> CAC : OK

@enduml