@startuml
title Deserialize (UDS Request Parser) - Dynamic Behaviour

participant "Serial Driver" as SD
participant "Deserialize" as DES
participant "Central App Controller" as CAC

== SID 0x22 ReadDataByIdentifier ==
SD -> DES : ReceiveFrame([0x22, 0x10, 0x01])
DES -> DES : ExtractSID() -> 0x22
DES -> DES : DecodeDID() -> 0x1001
alt Valid frame (length >= 3)
    DES -> CAC : Dispatch(UDS_Request{sid=0x22, did=0x1001})
    CAC --> DES : ACK
else Malformed frame (length < 3)
    DES -> CAC : ReportError(requestSID=0x22, nrc=0x13)
    CAC --> DES : Error_Acknowledged
end

== SID 0x2E WriteDataByIdentifier ==
SD -> DES : ReceiveFrame([0x2E, 0x10, 0x01, 0x04, 0x00])
DES -> DES : ExtractSID() -> 0x2E
DES -> DES : DecodeDID() -> 0x1001
DES -> DES : ExtractPayload() -> [0x04, 0x00]
alt Valid frame (length > 3)
    DES -> CAC : Dispatch(UDS_Request{sid=0x2E, did=0x1001, data=[0x04,0x00]})
    CAC --> DES : ACK
else Malformed frame (no data after DID)
    DES -> CAC : ReportError(requestSID=0x2E, nrc=0x13)
    CAC --> DES : Error_Acknowledged
end

== SID 0x31 RoutineControl ==
SD -> DES : ReceiveFrame([0x31, 0x01, 0x02, 0x00])
DES -> DES : ExtractSID() -> 0x31
DES -> DES : DecodeRoutineControlType() -> 0x01 (startRoutine)
DES -> DES : DecodeRoutineID() -> 0x0200
alt Valid frame (length >= 4)
    DES -> CAC : Dispatch(UDS_Request{sid=0x31, routineControlType=0x01, routineID=0x0200})
    CAC --> DES : ACK
else Malformed frame
    DES -> CAC : ReportError(requestSID=0x31, nrc=0x13)
    CAC --> DES : Error_Acknowledged
end

== Unsupported SID ==
SD -> DES : ReceiveFrame([0x10, ...])
DES -> DES : ExtractSID() -> 0x10 (not in {0x22, 0x2E, 0x31})
DES -> CAC : ReportError(requestSID=0x10, nrc=0x11)
CAC --> DES : Error_Acknowledged

@enduml