@startuml

title Deserialize (UDS Request Parser) - Static View

package "Deserialize" {
    [SID Dispatcher] as dispatcher
    note right of dispatcher
        - Reads first byte (SID)
        - Routes to correct sub-parser
        - 0x22: ReadDataByIdentifier
        - 0x2E: WriteDataByIdentifier
        - 0x31: RoutineControl
    end note

    [DID Decoder] as didDecoder
    note right of didDecoder
        - Decodes DID (2 bytes, big-endian)
        - Used by SID 0x22 and 0x2E
    end note

    [Payload Extractor] as payloadExtractor
    note right of payloadExtractor
        - Extracts data bytes following DID
        - Used by SID 0x2E
    end note

    [Routine Decoder] as routineDecoder
    note right of routineDecoder
        - Decodes routineControlType (1 byte)
        - Decodes routineIdentifier (2 bytes, big-endian)
        - Used by SID 0x31
    end note
}

[Serial Driver] as serialDriver
[Central App Controller] as controller

serialDriver --> dispatcher : Raw UDS frame (bytes)
dispatcher --> didDecoder : SID 0x22 / 0x2E frame
dispatcher --> routineDecoder : SID 0x31 frame
didDecoder --> payloadExtractor : SID 0x2E frame
didDecoder --> controller : UDS_Request{sid=0x22, did}
payloadExtractor --> controller : UDS_Request{sid=0x2E, did, data}
routineDecoder --> controller : UDS_Request{sid=0x31, routineControlType, routineID}
dispatcher --> controller : UDS_Error{requestSID, nrc=0x11} on unsupported SID

@enduml