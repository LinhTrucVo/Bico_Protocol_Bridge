@startuml
title Digital Service - Dynamic Behaviour

participant "Central App Controller" as CC
participant "Digital Service" as DA
participant "GPIO Driver" as GPIO
participant "PWM Driver" as PWM
participant "Config Service" as CS

== Initialization ==
CC -> DA : DigitalService_Init()
DA -> CS : ConfigService_GetGpioConfig()
CS --> DA : gpio_config
DA -> DA : InitializeGPIOPins(gpio_config)
loop For each configured GPIO pin
    DA -> GPIO : GPIO_Init(pin, mode, pull)
    GPIO --> DA : SUCCESS
end
DA -> CS : ConfigService_GetPwmConfig()
CS --> DA : pwm_config
loop For each configured PWM channel
    DA -> PWM : PWM_Init(ch, freq, duty)
    PWM --> DA : SUCCESS
end
DA --> CC : INIT_SUCCESS

== GPIO Write ==
CC -> DA : DigitalService_WriteGpio(pin=PA5, state=HIGH)
DA -> GPIO : GPIO_WritePin(PA5, HIGH)
GPIO --> DA : SUCCESS
DA --> CC : OK

== GPIO Read ==
CC -> DA : DigitalService_ReadGpio(pin=PB3)
DA -> GPIO : GPIO_ReadPin(PB3)
GPIO --> DA : pin_state=HIGH
DA --> CC : pin_state=HIGH

== PWM Start ==
CC -> DA : DigitalService_StartPwm(channel=1)
DA -> PWM : PWM_Start(ch=1)
PWM --> DA : SUCCESS
DA --> CC : OK

== PWM Stop ==
CC -> DA : DigitalService_StopPwm(channel=1)
DA -> PWM : PWM_Stop(ch=1)
PWM --> DA : SUCCESS
DA --> CC : OK

@enduml