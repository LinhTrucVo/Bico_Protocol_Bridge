@startuml
title NVM Driver - Information Flow


package "Initialization Flow" {
    component "Higher Layer" as HL1
    component "NVM Driver" as ND1
    component "Vendor Flash HAL" as HAL1
    
    HL1 -down-> ND1 : Init Request
    ND1 -down-> HAL1 : HAL_FLASH_Init()
    HAL1 -up-> ND1 : Status
    ND1 -up-> HL1 : Init Status
}

package "Write Flow" {
    component "Higher Layer" as HL2
    component "NVM Driver" as ND2
    component "Vendor Flash HAL" as HAL2
    
    HL2 -down-> ND2 : Write Data\n(addr, data)
    ND2 -down-> HAL2 : HAL_FLASH_Unlock()
    ND2 -down-> HAL2 : HAL_FLASH_Program()
    HAL2 -up-> ND2 : Status
    ND2 -down-> HAL2 : HAL_FLASH_Lock()
    ND2 -up-> HL2 : Write Status
}

package "Read Flow" {
    component "Higher Layer" as HL3
    component "NVM Driver" as ND3
    component "Vendor Flash HAL" as HAL3
    
    HL3 -down-> ND3 : Read Data\n(addr, size)
    ND3 -down-> HAL3 : HAL_FLASH_Read()
    HAL3 -up-> ND3 : Data
    ND3 -up-> HL3 : Read Data
}

package "Erase Flow" {
    component "Higher Layer" as HL4
    component "NVM Driver" as ND4
    component "Vendor Flash HAL" as HAL4
    
    HL4 -down-> ND4 : Erase Sector (addr)
    ND4 -down-> HAL4 : HAL_FLASH_Erase()
    HAL4 -up-> ND4 : Status
    ND4 -up-> HL4 : Erase Status
}

@enduml
