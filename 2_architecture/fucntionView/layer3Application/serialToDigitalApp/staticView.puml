@startuml

title SerialToDigital App - Static View

package "SerialToDigital App" {
    [Routine Handler] as routineHandler
    note right of routineHandler
        RID 0x0200: GPIO write
        RID 0x0201: GPIO read
        RID 0x0300: PWM start
        RID 0x0301: PWM stop
    end note
    [GPIO Manager] as gpioMgr
    [PWM Manager] as pwmMgr
    [Pin Mode Manager] as pinModeMgr
}

[GPIO Driver] as gpioDriver
[PWM Driver] as pwmDriver
[Config Service] as configService

routineHandler --> gpioMgr : RID 0x02xx
routineHandler --> pwmMgr : RID 0x03xx
gpioMgr --> pinModeMgr : Mode check
gpioMgr --> gpioDriver : Digital operations
pwmMgr --> pwmDriver : PWM operations

note right of gpioMgr
    Config loaded from Config Service at init.
    No runtime config saving here.
end note

@enduml