@startuml
title SerialToDigital App - Dynamic Behaviour

participant "Central App Controller" as CC
participant "Digital App" as DA
participant "GPIO Driver" as GPIO
participant "PWM Driver" as PWM
participant "Config Service" as CS

== Initialization ==
CC -> DA : DigitalApp_Init()
DA -> CS : ConfigService_Get(did=GPIO_CONFIG_DID)
CS --> DA : config_data
DA -> DA : InitializeGPIOPins(config_data)
loop For each configured GPIO pin
    DA -> GPIO : GPIO_Init(pin, mode, pull)
    GPIO --> DA : SUCCESS
end
DA -> CS : ConfigService_Get(did=PWM_CONFIG_DID)
CS --> DA : pwm_config
loop For each configured PWM channel
    DA -> PWM : PWM_Init(ch, freq, duty)
    PWM --> DA : SUCCESS
end
DA --> CC : INIT_SUCCESS

== RID 0x0200 GPIO Write ==
CC -> DA : ExecuteRoutine(rid=0x0200, params={pin=PA5, state=HIGH})
DA -> GPIO : GPIO_WritePin(PA5, HIGH)
GPIO --> DA : SUCCESS
DA --> CC : result={status=0x00}

== RID 0x0201 GPIO Read ==
CC -> DA : ExecuteRoutine(rid=0x0201, params={pin=PB3})
DA -> GPIO : GPIO_ReadPin(PB3)
GPIO --> DA : pin_state=HIGH
DA --> CC : result={pin_state=HIGH, status=0x00}

== RID 0x0300 PWM Start ==
CC -> DA : ExecuteRoutine(rid=0x0300, params={ch=1})
DA -> PWM : PWM_Start(ch=1)
PWM --> DA : SUCCESS
DA --> CC : result={status=0x00}

== RID 0x0301 PWM Stop ==
CC -> DA : ExecuteRoutine(rid=0x0301, params={ch=1})
DA -> PWM : PWM_Stop(ch=1)
PWM --> DA : SUCCESS
DA --> CC : result={status=0x00}

@enduml