@startuml
title SerialToDigital App - Information Flow

package "RID 0x0200 GPIO Write Flow" {
    component "Central App Controller" as CC1
    component "SerialToDigital App" as DA1
    component "GPIO Driver" as GPIO1

    CC1 -down-> DA1 : WriteGPIO(pin=PA5, state=HIGH)
    DA1 -down-> GPIO1 : GPIO_WritePin(PA5, HIGH)
    GPIO1 -up-> DA1 : SUCCESS
    DA1 -up-> CC1 : status=0x00
}

package "RID 0x0201 GPIO Read Flow" {
    component "Central App Controller" as CC2
    component "SerialToDigital App" as DA2
    component "GPIO Driver" as GPIO2

    CC2 -down-> DA2 : ReadGPIO(pin=PB3)
    DA2 -down-> GPIO2 : GPIO_ReadPin(PB3)
    GPIO2 -up-> DA2 : pin_state=HIGH
    DA2 -up-> CC2 : pin_state=HIGH
}

package "RID 0x0300 PWM Start Flow" {
    component "Central App Controller" as CC3
    component "SerialToDigital App" as DA3
    component "PWM Driver" as PWM3

    CC3 -down-> DA3 : StartPWM(ch=1)
    DA3 -down-> PWM3 : PWM_Start(ch=1)
    PWM3 -up-> DA3 : SUCCESS
    DA3 -up-> CC3 : status=0x00
}

package "RID 0x0301 PWM Stop Flow" {
    component "Central App Controller" as CC4
    component "SerialToDigital App" as DA4
    component "PWM Driver" as PWM4

    CC4 -down-> DA4 : StopPWM(ch=1)
    DA4 -down-> PWM4 : PWM_Stop(ch=1)
    PWM4 -up-> DA4 : SUCCESS
    DA4 -up-> CC4 : status=0x00
}

@enduml