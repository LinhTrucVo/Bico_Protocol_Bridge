@startuml
title Central App Controller - Dynamic Behaviour

participant "Main" as MAIN
participant "Central App Controller" as CAC
participant "Config Service" as CS
participant "Deserialize" as DES
participant "Serialize" as SER
participant "Analog App" as AA
participant "Digital App" as DA
participant "I2C App" as I2C
participant "SPI App" as SPI

== System Initialization ==
MAIN -> CAC : CentralAppController_Init()
CAC -> CS : ConfigService_Init()
CS --> CAC : CONFIG_LOADED
CAC -> AA : AnalogApp_Init()
AA --> CAC : INIT_SUCCESS
CAC -> DA : DigitalApp_Init()
DA --> CAC : INIT_SUCCESS
CAC -> I2C : I2CApp_Init()
I2C --> CAC : INIT_SUCCESS
CAC -> SPI : SPIApp_Init()
SPI --> CAC : INIT_SUCCESS
CAC --> MAIN : SYSTEM_READY

== SID 0x22 Read Config ==
DES -> CAC : Dispatch(UDS_Request{sid=0x22, did=0x1001})
CAC -> CS : ConfigService_Get(did=0x1001)
CS --> CAC : data=[0x04, 0x00]
CAC -> SER : BuildResponse(sid=0x22, did=0x1001, data)

== SID 0x2E Write Config ==
DES -> CAC : Dispatch(UDS_Request{sid=0x2E, did=0x1001, data=[0x08,0x00]})
CAC -> CS : ConfigService_Validate(did=0x1001, data)
alt Valid
    CS --> CAC : VALID
    CAC -> CS : ConfigService_Set(did=0x1001, data)
    CS --> CAC : OK
    CAC -> SER : BuildResponse(sid=0x2E, did=0x1001)
else Invalid
    CS --> CAC : INVALID (nrc=0x31)
    CAC -> SER : BuildNegativeResponse(requestSID=0x2E, nrc=0x31)
end

== SID 0x31 RID Dispatch ==
DES -> CAC : Dispatch(UDS_Request{sid=0x31, routineControlType=0x01, rid, params})
CAC -> CAC : RouteByRID(rid)

alt RID 0x01xx (ADC)
    CAC -> AA : ExecuteRoutine(rid, params)
    AA --> CAC : result
    CAC -> SER : BuildResponse(sid=0x31, rid, data=result)

else RID 0x02xx / 0x03xx (GPIO / PWM)
    CAC -> DA : ExecuteRoutine(rid, params)
    DA --> CAC : result
    CAC -> SER : BuildResponse(sid=0x31, rid, data=result)

else RID 0x04xx (I2C)
    CAC -> I2C : ExecuteRoutine(rid, params)
    I2C --> CAC : result
    CAC -> SER : BuildResponse(sid=0x31, rid, data=result)

else RID 0x05xx (SPI)
    CAC -> SPI : ExecuteRoutine(rid, params)
    SPI --> CAC : result
    CAC -> SER : BuildResponse(sid=0x31, rid, data=result)

else Unknown RID
    CAC -> SER : BuildNegativeResponse(requestSID=0x31, nrc=0x31)
end

@enduml