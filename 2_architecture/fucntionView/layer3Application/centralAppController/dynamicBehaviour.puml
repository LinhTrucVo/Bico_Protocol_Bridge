@startuml
title Central App Controller - Dynamic Behaviour

participant "Main" as MAIN
participant "Central App Controller" as CAC
participant "ComService" as COM
participant "Frame Parser" as FP
participant "Config Service" as CS
participant "Deserialize" as DES
participant "Serialize" as SER
participant "Analog Service" as AA
participant "Digital Service" as DA
participant "I2C Service" as I2C
participant "SPI Service" as SPI

== System Initialization ==
MAIN -> CAC : CentralAppController_Init()
CAC -> CS : ConfigService_Init()
CS --> CAC : CONFIG_LOADED
CAC -> AA : AnalogServiceUnit_Init()
AA --> CAC : INIT_SUCCESS
CAC -> DA : DigitalServiceUnit_Init()
DA --> CAC : INIT_SUCCESS
CAC -> I2C : I2cServiceUnit_Init()
I2C --> CAC : INIT_SUCCESS
CAC -> SPI : SpiServiceUnit_Init()
SPI --> CAC : INIT_SUCCESS
CAC -> FP : FrameParser_Reset()
CAC --> MAIN : SYSTEM_READY

== Run (periodic) - Frame Extraction from Serial Stream ==
MAIN -> CAC : CentralAppController_Run()
CAC -> COM : ComServiceUnit_IsRxDataAvailable()
COM --> CAC : true
CAC -> COM : ComServiceUnit_Read(rxBuf, maxLen, &rxLen)
COM --> CAC : rxLen bytes

loop For each received byte
    CAC -> FP : FrameParser_ProcessByte(byte)
    note right of FP
      Frame format:
      [0x55][0x55][UDS payload][0xAA][0xAA]
      Prefix and postfix are configurable macros.
    end note
end

alt Frame complete (prefix + payload + postfix detected)
    FP --> CAC : frameReady = true

    == UDS Dispatch ==
    CAC -> DES : DeserializeUnit_Parse(frameBuffer, frameLength)
    DES --> CAC : UDS_Request{sid, id, payload}

    alt SID 0x22 Read Config
        CAC -> CS : ConfigService_Get...(param)
        CS --> CAC : value
        CAC -> SER : BuildReadResponse(did, data)
    else SID 0x2E Write Config
        CAC -> CS : ConfigService_Set...(param, value)
        CS --> CAC : OK / ERROR
        CAC -> SER : BuildWriteResponse(did) or BuildNegativeResponse(nrc)
    else SID 0x31 Peripheral Control
        CAC -> AA : analogService / digitalService / i2cService / spiService
        AA --> CAC : result
        CAC -> SER : BuildRoutineResponse(rid, statusRecord)
    end

    == Send Framed Response ==
    CAC -> CAC : Wrap response with prefix [0x55,0x55] + postfix [0xAA,0xAA]
    CAC -> COM : ComServiceUnit_Write(framedResponse, totalLength)
    CAC -> FP : FrameParser_Reset()
end

@enduml