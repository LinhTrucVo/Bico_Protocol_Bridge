@startuml

title Central App Controller - Static View

package "Central App Controller" {
    [System Initializer] as init
    [UDS Command Dispatcher] as dispatcher
    note right of dispatcher
        Owns all DID/RID definitions.
        Maps DID/RID + payload to typed API calls.
    end note
    [DID/RID Mapper] as mapper
    note right of mapper
        DID 0x1001 -> ConfigService.SetAdcSampleRate(rate)
        DID 0x1002 -> ConfigService.SetAdcResolution(res)
        RID 0x0100 -> AnalogApp.ReadAdc(channel)
        RID 0x0200 -> DigitalApp.WriteGpio(pin, state)
        RID 0x0201 -> DigitalApp.ReadGpio(pin)
        RID 0x0300 -> DigitalApp.StartPwm(channel)
        RID 0x0301 -> DigitalApp.StopPwm(channel)
        RID 0x0400 -> I2CApp.Write(addr, data)
        RID 0x0401 -> I2CApp.Read(addr, len)
        RID 0x0500 -> SPIApp.Write(dev, data)
        RID 0x0501 -> SPIApp.Transceive(dev, tx, rx_len)
    end note
    [State Manager] as stateMgr
    [Health Monitor] as watchdog
}

[SerialToAnalog App] as analogApp
[SerialToDigital App] as digitalApp
[SerialToI2C App] as i2cApp
[SerialToSPI App] as spiApp
[Deserialize] as deserialize
[Serialize] as serialize
[Config Service] as configService

deserialize -[#orange]-> dispatcher : UDS_Request{sid, did/rid, raw payload}
dispatcher --> mapper : Decode DID/RID + extract params
mapper -[#purple]-> configService : Typed API (e.g. SetAdcSampleRate(1000))
mapper -[#blue]-> analogApp : Typed API (e.g. ReadAdc(ch=1))
mapper -[#blue]-> digitalApp : Typed API (e.g. WriteGpio(PA5, HIGH))
mapper -[#blue]-> i2cApp : Typed API (e.g. Write(0x50, data))
mapper -[#blue]-> spiApp : Typed API (e.g. Transceive(dev, tx, rx_len))
dispatcher -[#orange]-> serialize : UDS_Response / UDS_Error
init -[#green]-> analogApp : Initialize
init -[#green]-> digitalApp : Initialize
init -[#green]-> i2cApp : Initialize
init -[#green]-> spiApp : Initialize

@enduml