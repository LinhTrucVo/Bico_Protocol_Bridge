@startuml
title SerialToAnalog App - Dynamic Behaviour

participant "Central App Controller" as CC
participant "Analog App" as AA
participant "ADC Driver" as ADC
participant "Config Service" as CS

== Initialization ==
CC -> AA : AnalogApp_Init()
AA -> CS : ConfigService_Get(did=ADC_CONFIG_DID)
CS --> AA : config_data
AA -> AA : InitializeChannels(config_data)
loop For each configured channel
    AA -> ADC : ADC_ConfigChannel(ch, resolution, rate)
    ADC --> AA : SUCCESS
end
AA --> CC : INIT_SUCCESS

== RID 0x0100 ADC Read (startRoutine) ==
CC -> AA : ExecuteRoutine(rid=0x0100, params={ch=1})
AA -> ADC : ADC_StartSingle(ch=1)
ADC -> ADC : Perform conversion
ADC -> AA : ConversionComplete_Callback(raw_value=2048)
alt Conversion OK
    AA --> CC : result={raw_value=2048, status=0x00}
else Conversion Error
    AA --> CC : result={status=0x01}
end

@enduml