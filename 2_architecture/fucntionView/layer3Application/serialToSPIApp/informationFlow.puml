@startuml
title SerialToSPI App - Information Flow

package "SPI Write Flow" {
    component "Central App Controller" as CC1
    component "SerialToSPI App" as SPI1
    component "SPI Master Driver" as DRV1
    component "GPIO Driver" as GPIO1

    CC1 -down-> SPI1 : SPIApp_Write(dev=0, data=[0x9F], len=1)
    SPI1 -down-> GPIO1 : GPIO_WritePin(cs_pin, LOW)
    SPI1 -down-> DRV1 : SPIMaster_Transmit(data, len=1)
    DRV1 -up-> SPI1 : SUCCESS
    SPI1 -down-> GPIO1 : GPIO_WritePin(cs_pin, HIGH)
    SPI1 -up-> CC1 : OK
}

package "SPI Transceive Flow" {
    component "Central App Controller" as CC2
    component "SerialToSPI App" as SPI2
    component "SPI Master Driver" as DRV2
    component "GPIO Driver" as GPIO2

    CC2 -down-> SPI2 : SPIApp_Transceive(dev=0, tx=[0x9F], rx_len=3)
    SPI2 -down-> GPIO2 : GPIO_WritePin(cs_pin, LOW)
    SPI2 -down-> DRV2 : SPIMaster_TransmitReceive(tx, rx_buf, len)
    DRV2 -up-> SPI2 : rx=[0xEF, 0x40, 0x18]
    SPI2 -down-> GPIO2 : GPIO_WritePin(cs_pin, HIGH)
    SPI2 -up-> CC2 : data=[0xEF, 0x40, 0x18]
}

@enduml