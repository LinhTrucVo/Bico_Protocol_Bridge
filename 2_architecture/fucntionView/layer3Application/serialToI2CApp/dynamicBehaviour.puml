@startuml
title SerialToI2C App - Dynamic Behaviour

participant "Central App Controller" as CC
participant "I2C App" as I2C
participant "I2C Master Driver" as DRV
participant "Config Service" as CS

== Initialization ==
CC -> I2C : I2CApp_Init()
I2C -> CS : ConfigService_GetI2cClockSpeed()
CS --> I2C : clockSpeed=400000
I2C -> DRV : I2CMaster_Init(clockSpeed=400000)
DRV --> I2C : SUCCESS
I2C --> CC : INIT_SUCCESS

== I2C Write ==
CC -> I2C : I2CApp_Write(addr=0x50, data=[0x10,0xAA], len=2)
I2C -> DRV : I2CMaster_Write(addr=0x50, data, len=2)
alt ACK received
    DRV --> I2C : ACK
    I2C --> CC : OK
else NACK / timeout
    DRV --> I2C : NACK
    I2C --> CC : ERROR_NACK
end

== I2C Read ==
CC -> I2C : I2CApp_Read(addr=0x50, len=2)
I2C -> DRV : I2CMaster_Read(addr=0x50, buffer, len=2)
alt Data received
    DRV --> I2C : data=[0xAA, 0xBB]
    I2C --> CC : data=[0xAA, 0xBB]
else Error
    DRV --> I2C : ERROR
    I2C --> CC : ERROR_BUS
end

@enduml