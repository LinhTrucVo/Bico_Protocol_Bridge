@startuml Feature_UserBenefit

!define BENEFIT #90EE90
!define FEATURE #87CEEB
!define USER #FFB6C1

package "User Benefits" {

    rectangle "Serial to Analog" as Feature FEATURE {
        rectangle "Analog Signal Reading" as Reading
        rectangle "Analog Configuration" as Config
        rectangle "Configuration Storage" as Storage
    }

    actor User USER

    rectangle "Quick Prototyping" as Benefit1 BENEFIT
    rectangle "No Complex Coding" as Benefit2 BENEFIT
    rectangle "Flexible Monitoring" as Benefit3 BENEFIT
    rectangle "Time & Cost Savings" as Benefit4 BENEFIT
    rectangle "Multi-Channel Support" as Benefit5 BENEFIT

    User --> Feature: Uses serial commands

    Reading --> Benefit1: Simple read interface
    Reading --> Benefit5: Multiple sensors at once

    Config --> Benefit2: No ADC driver coding
    Config --> Benefit3: Adjustable resolution/rate

    Storage --> Benefit4: No reconfiguration needed
    Storage --> Benefit3: Persistent sensor settings

    Benefit1 --> User: Faster development
    Benefit2 --> User: Reduced learning curve
    Benefit3 --> User: Versatile applications
    Benefit4 --> User: Efficient workflow
    Benefit5 --> User: Simplified data acquisition
}

note right of Feature
  **Key Features:**
  * Raw ADC value reading via serial
  * Configurable sampling rate
  * Configurable resolution (8/10/12/16-bit)
  * Multi-channel analog input
  * Threshold monitoring
  * Non-volatile configuration
end note

@enduml
