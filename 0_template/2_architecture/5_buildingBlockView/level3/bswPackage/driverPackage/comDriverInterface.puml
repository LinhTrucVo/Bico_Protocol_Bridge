@startuml comDriverInterface
skinparam classAttributeIconSize 0
hide circle
hide empty members

class "Com driver" as COMD <<component>> #LightBlue {
  .. provides ..
  +ComDriver_canSend(id, data)
  +ComDriver_getCanStatus()
  +ComDriver_rxIndication(id, data)
  .. requires ..
  -HwImplementation1_canTransmit(id, data)
  -HwImplementation1_getCanStatus()
}

legend right
  |= Section |= Meaning |
  | provides (+) | Interface offered by the component |
  | requires (-) | Interface the component needs from another component |
endlegend
@enduml
