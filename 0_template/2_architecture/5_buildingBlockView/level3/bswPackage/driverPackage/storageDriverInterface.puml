@startuml storageDriverInterface
skinparam classAttributeIconSize 0
hide circle
hide empty members

class "Storage driver" as STOD <<component>> #LightBlue {
  .. provides ..
  +StorageDriver_flashRead(address, length)
  +StorageDriver_flashWrite(address, data)
  .. requires ..
  -HwImplementation1_flashRead(address, length)
  -HwImplementation1_flashWrite(address, data)
}

legend right
  |= Section |= Meaning |
  | provides (+) | Interface offered by the component |
  | requires (-) | Interface the component needs from another component |
endlegend
@enduml
