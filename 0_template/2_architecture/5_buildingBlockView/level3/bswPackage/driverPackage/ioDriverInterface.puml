@startuml ioDriverInterface
skinparam classAttributeIconSize 0
hide circle
hide empty members

class "IO driver" as IOD <<component>> #LightBlue {
  .. provides ..
  +IoDriver_readPin(pin)
  +IoDriver_writePin(pin, level)
  .. requires ..
  -HwImplementation2_readPin(pin)
  -HwImplementation2_writePin(pin, level)
}

legend right
  |= Section |= Meaning |
  | provides (+) | Interface offered by the component |
  | requires (-) | Interface the component needs from another component |
endlegend
@enduml
