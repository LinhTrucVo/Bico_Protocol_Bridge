@startuml diagnosticServiceInterface
skinparam classAttributeIconSize 0
hide circle
hide empty members

class "Diagnostic service" as DIAS <<component>> #LightBlue {
  .. provides ..
  +DiagnosticService_reportEvent(id)
  +DiagnosticService_getDiagnosticStatus()
  .. requires ..
  -StorageService_readData(key)
  -StorageService_writeData(key, data)
  -ComService_sendMessage(id, data)
}

legend right
  |= Section |= Meaning |
  | provides (+) | Interface offered by the component |
  | requires (-) | Interface the component needs from another component |
endlegend
@enduml
