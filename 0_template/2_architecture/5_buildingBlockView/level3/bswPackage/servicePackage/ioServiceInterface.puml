@startuml ioServiceInterface
skinparam classAttributeIconSize 0
hide circle
hide empty members

class "IO service" as IOS <<component>> #LightBlue {
  .. provides ..
  +IoService_setOutput(channel, level)
  +IoService_getInput(channel)
  .. requires ..
  -IoDriver_readPin(pin)
  -IoDriver_writePin(pin, level)
}

legend right
  |= Section |= Meaning |
  | provides (+) | Interface offered by the component |
  | requires (-) | Interface the component needs from another component |
endlegend
@enduml
