@startuml comServiceInterface
skinparam classAttributeIconSize 0
hide circle
hide empty members

class "Com service" as COMS <<component>> #LightBlue {
  .. provides ..
  +ComService_sendMessage(id, data)
  +ComService_receiveCallBack()
  .. requires ..
  -ComDriver_canSend(id, data)
  -ComDriver_getCanStatus()
}

legend right
  |= Section |= Meaning |
  | provides (+) | Interface offered by the component |
  | requires (-) | Interface the component needs from another component |
endlegend
@enduml
