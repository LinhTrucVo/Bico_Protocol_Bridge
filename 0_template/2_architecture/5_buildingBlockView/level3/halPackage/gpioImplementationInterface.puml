@startuml gpioImplementationInterface
skinparam classAttributeIconSize 0
hide circle
hide empty members

class "ESP32 GPIO implementation" as GPIOESP <<component>> #LightSalmon {
  .. provides (GPIO HAL API) ..
  +GpioPort_init(pin, direction)
  +GpioPort_read(pin)
  +GpioPort_write(pin, level)
  +GpioPort_toggle(pin)
  .. requires ..
  -gpio_config()
  -gpio_get_level()
  -gpio_set_level()
}

class "STM32 GPIO implementation" as GPIOSTM <<component>> #LightSalmon {
  .. provides (GPIO HAL API) ..
  +GpioPort_init(pin, direction)
  +GpioPort_read(pin)
  +GpioPort_write(pin, level)
  +GpioPort_toggle(pin)
  .. requires ..
  -HAL_GPIO_Init()
  -HAL_GPIO_ReadPin()
  -HAL_GPIO_WritePin()
  -HAL_GPIO_TogglePin()
}

legend right
  |= Section |= Meaning |
  | provides (+) | Interface offered by the component |
  | requires (-) | Interface the component needs from the hardware or 3rd-party SW |
endlegend
@enduml
