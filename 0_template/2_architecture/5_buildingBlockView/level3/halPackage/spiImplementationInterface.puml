@startuml spiImplementationInterface
skinparam classAttributeIconSize 0
hide circle
hide empty members

class "ESP32 SPI implementation" as SPIESP <<component>> #LightSalmon {
  .. provides (SPI HAL API) ..
  +SpiMasterPort_init(bus, config)
  +SpiMasterPort_transfer(bus, txData, rxData, length)
  .. requires ..
  -spi_bus_initialize()
  -spi_device_polling_transmit()
}

class "STM32 SPI implementation" as SPISTM <<component>> #LightSalmon {
  .. provides (SPI HAL API) ..
  +SpiMasterPort_init(bus, config)
  +SpiMasterPort_transfer(bus, txData, rxData, length)
  .. requires ..
  -HAL_SPI_Init()
  -HAL_SPI_TransmitReceive()
}

legend right
  |= Section |= Meaning |
  | provides (+) | Interface offered by the component |
  | requires (-) | Interface the component needs from the hardware or 3rd-party SW |
endlegend
@enduml
