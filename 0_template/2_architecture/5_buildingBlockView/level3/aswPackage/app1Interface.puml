@startuml app1Interface
skinparam classAttributeIconSize 0
hide circle
hide empty members

class "App 1" as APP1 <<component>> #LightGreen {
  .. provides ..
  +App1_execute(request)
  +App1_getResult()
  .. requires ..
  -ComService_sendMessage(id, data)
  -ComService_receiveCallBack()
}

legend right
  |= Section |= Meaning |
  | provides (+) | Interface offered by the component |
  | requires (-) | Interface the component needs from another component |
endlegend
@enduml
