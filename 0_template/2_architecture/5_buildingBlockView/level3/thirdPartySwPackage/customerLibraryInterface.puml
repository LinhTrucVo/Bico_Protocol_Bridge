@startuml customerLibraryInterface
skinparam classAttributeIconSize 0
hide circle
hide empty members

class "Customer-specific library" as CLIB <<component>> #LightGrey {
  .. provides ..
  +CustomerLibrary_libraryApi()
  .. requires ..
  -Libc_stdLibApi()
}

legend right
  |= Section |= Meaning |
  | provides (+) | Interface offered by the component |
  | requires (-) | Interface the component needs from the system |
endlegend
@enduml
