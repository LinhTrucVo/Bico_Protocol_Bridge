@startuml vendorSdkInterface
skinparam classAttributeIconSize 0
hide circle
hide empty members

class "ESP-IDF GPIO driver" as VSDK <<component>> #LightGrey {
  .. provides ..
  +gpio_config()
  +gpio_set_level()
  +gpio_get_level()
  +gpio_set_direction()
