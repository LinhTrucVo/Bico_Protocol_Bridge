@startuml deserializeStaticStructure
skinparam backgroundColor #FEFEFE

package "deserialize" {
    interface IDeserialize {
        + Init() : Status_t
        + DeInit() : Status_t
        + Parse(pFrame, pRequest) : Status_t
    }

    class Deserialize_Context_t {
        - initialized: bool
    }

    class Deserialize_Frame_t {
        + pData: const uint8_t*
        + length: uint16_t
    }

    class Deserialize_UdsRequest_t {
        + sid: uint8_t
        + id: uint16_t
        + routineControlType: uint8_t
        + pPayload: const uint8_t*
        + payloadLength: uint16_t
    }

    IDeserialize --> Deserialize_Context_t : manages\n(static instance)
    IDeserialize --> Deserialize_Frame_t : validates
    IDeserialize --> Deserialize_UdsRequest_t : produces
}

note right of Deserialize_Frame_t
    UDS frame format:
    [0] = SID (0x22, 0x2E, 0x31)
    [1-2] = DID/RID (big-endian)
    [3..] = Payload (for 0x2E/0x31)
    
    For SID 0x31:
    [1] = routineControlType
    [2-3] = RID (big-endian)
    [4..] = Parameters
end note
@enduml