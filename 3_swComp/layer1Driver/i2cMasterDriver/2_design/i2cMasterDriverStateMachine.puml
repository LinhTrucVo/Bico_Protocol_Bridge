@startuml i2cMasterDriverStateMachine
state Uninitialized
state Initialized
state Busy

[*] --> Uninitialized

Uninitialized --> Initialized : Init(config)
Initialized --> Uninitialized : DeInit()

Initialized --> Initialized : SetSpeed()

Initialized --> Busy : Write() / Read()
Initialized --> Busy : WriteRead()
Initialized --> Busy : WriteRegister()
Initialized --> Busy : ReadRegister()
Initialized --> Busy : ScanBus()

Busy --> Initialized : Operation complete
Busy --> Initialized : Timeout

Initialized --> Initialized : IsBusy()
Initialized --> Initialized : RegisterCallback()

note right of Busy
  busy = true
  Callback invoked when done
  Can timeout if configured
end note
@enduml
