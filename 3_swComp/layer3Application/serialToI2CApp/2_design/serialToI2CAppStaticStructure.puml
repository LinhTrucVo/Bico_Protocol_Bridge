@startuml serialToI2CAppStaticStructure
skinparam backgroundColor #FEFEFE

package "serialToI2CApp" {
    interface ISerialToI2CApp {
        + Init() : Status_t
        + DeInit() : Status_t
        + Write(address, pData, length) : Status_t
        + Read(address, pData, length) : Status_t
    }

    class SerialToI2CApp_Context_t {
        - initialized: bool
    }

    ISerialToI2CApp --> SerialToI2CApp_Context_t : manages
}

package "layer1Driver" {
    interface II2cMasterDriver {
        + I2cMasterDriver_Write(addr, pData, len) : Status_t
        + I2cMasterDriver_Read(addr, pData, len) : Status_t
    }
}

ISerialToI2CApp --> II2cMasterDriver : delegates

note right of ISerialToI2CApp
  No UDS awareness.
  Called by CAC for:
  - RID 0x0400: Write(address, pData, length)
  - RID 0x0401: Read(address, pData, length)
end note
@enduml