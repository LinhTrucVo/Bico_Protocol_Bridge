@startuml serialToAnalogAppStateMachine
state Uninitialized
state Initialized
state Running

[*] --> Uninitialized

Uninitialized --> Initialized : Init()

Initialized --> Running : Run()

Running --> Running : ProcessFrame()

Running --> Initialized : Stop()

Initialized --> Uninitialized : DeInit()

note right of Running
  Application actively processing
  serial commands and generating
  analog outputs
end note
@enduml
