@startuml centralAppControllerStaticStructure
skinparam backgroundColor #FEFEFE

package "centralAppController" {
    interface ICentralAppController {
        + Init() : Status_t
        + DeInit() : Status_t
        + Run() : Status_t
        + GetState(pState) : Status_t
        + Dispatch(pRequestFrame, requestLength, pResponseBuffer, bufferSize, pResponseLength) : Status_t
        + RegisterErrorCallback(callback) : Status_t
    }

    class CAC_DID_Map <<static>> {
        + CAC_DID_ADC_SAMPLE_RATE = 0x1001
        + CAC_DID_ADC_RESOLUTION = 0x1002
        + CAC_DID_GPIO_CONFIG = 0x2001
        + CAC_DID_PWM_CONFIG = 0x3001
        + CAC_DID_I2C_CONFIG = 0x4001
        + CAC_DID_SPI_CONFIG = 0x5001
        + CAC_DID_SERIAL_CONFIG = 0x6001
    }

    class CAC_RID_Map <<static>> {
        + CAC_RID_ADC_READ = 0x0100
        + CAC_RID_GPIO_WRITE = 0x0200
        + CAC_RID_GPIO_READ = 0x0201
        + CAC_RID_PWM_START = 0x0300
        + CAC_RID_PWM_STOP = 0x0301
        + CAC_RID_I2C_WRITE = 0x0400
        + CAC_RID_I2C_READ = 0x0401
        + CAC_RID_SPI_WRITE = 0x0500
        + CAC_RID_SPI_TRANSCEIVE = 0x0501
    }

    class CentralAppController_Context_t {
        - initialized: bool
        - state: CentralAppController_State_t
        - errorCallback: CentralAppController_ErrorCallback_t
    }

    ICentralAppController --> CentralAppController_Context_t : manages\n(static instance)
}

package "layer2Service" {
    interface IDeserialize {
        + Parse(pFrame, pRequest) : Status_t
    }
    interface ISerialize {
        + BuildReadResponse(did, pData, dataLen, pResp) : Status_t
        + BuildWriteResponse(did, pResp) : Status_t
        + BuildRoutineResponse(routineControlType, rid, pStatusRecord, statusLen, pResp) : Status_t
        + BuildNegativeResponse(requestSid, nrc, pResp) : Status_t
    }
    interface IConfigService {
        + Get(did, pData, pLen) : Status_t
        + Set(did, pData, len) : Status_t
    }
}

package "peripheralApps" {
    interface ISerialToAnalogApp {
        + ReadAdc(channel, pRawValue) : Status_t
    }
    interface ISerialToDigitalApp {
        + WriteGpio(pin, state) : Status_t
        + ReadGpio(pin, pState) : Status_t
        + StartPwm(channel) : Status_t
        + StopPwm(channel) : Status_t
    }
    interface ISerialToI2CApp {
        + Write(address, pData, length) : Status_t
        + Read(address, pData, length) : Status_t
    }
    interface ISerialToSPIApp {
        + Write(device, pData, length) : Status_t
        + Transceive(device, pTxData, txLen, pRxData, rxLen) : Status_t
    }
}

ICentralAppController --> IDeserialize : uses
ICentralAppController --> ISerialize : uses
ICentralAppController --> IConfigService : DID read/write
ICentralAppController --> ISerialToAnalogApp : RID 0x0100
ICentralAppController --> ISerialToDigitalApp : RID 0x0200-0x0301
ICentralAppController --> ISerialToI2CApp : RID 0x0400-0x0401
ICentralAppController --> ISerialToSPIApp : RID 0x0500-0x0501
@enduml