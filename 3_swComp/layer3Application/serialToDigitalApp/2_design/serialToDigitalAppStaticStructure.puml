@startuml serialToDigitalAppStaticStructure
skinparam backgroundColor #FEFEFE

package "serialToDigitalApp" {
    interface ISerialToDigitalApp {
        + Init() : Status_t
        + DeInit() : Status_t
        + WriteGpio(pin, state) : Status_t
        + ReadGpio(pin, pState) : Status_t
        + StartPwm(channel) : Status_t
        + StopPwm(channel) : Status_t
    }

    class SerialToDigitalApp_Context_t {
        - initialized: bool
    }

    ISerialToDigitalApp --> SerialToDigitalApp_Context_t : manages
}

package "layer1Driver" {
    interface IGpioDriver {
        + GpioDriver_Write(pin, state) : Status_t
        + GpioDriver_Read(pin, pState) : Status_t
    }
    interface IPwmDriver {
        + PwmDriver_Start(channel) : Status_t
        + PwmDriver_Stop(channel) : Status_t
    }
}

ISerialToDigitalApp --> IGpioDriver : GPIO operations
ISerialToDigitalApp --> IPwmDriver : PWM operations

note right of ISerialToDigitalApp
  No UDS awareness.
  Called by CAC for:
  - RID 0x0201: WriteGpio
  - RID 0x0202: ReadGpio
  - RID 0x0301: StartPwm
  - RID 0x0302: StopPwm
end note
@enduml