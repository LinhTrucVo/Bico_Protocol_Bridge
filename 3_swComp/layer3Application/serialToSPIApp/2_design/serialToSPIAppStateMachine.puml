@startuml serialToSPIAppStateMachine
state Uninitialized
state Initialized
state Running

[*] --> Uninitialized

Uninitialized --> Initialized : Init()

Initialized --> Running : Run()

Running --> Running : ProcessFrame()

Running --> Initialized : Stop()

Initialized --> Uninitialized : DeInit()

note right of Running
  Actively processing serial-to-SPI
  commands via spiMasterDriver
end note
@enduml
