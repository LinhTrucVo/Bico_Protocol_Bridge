@startuml serialToSPIAppSequenceDiagram
participant "CAC" as cac
participant "SerialToSPIApp" as app
participant "SpiMasterDriver" as drv

== SPI Write (RID 0x0501) ==
cac -> app : SerialToSPIApp_Write(device, pData, len)
app -> app : Validate initialized
app -> drv : SpiMasterDriver_Write(device, pData, len)
drv --> app : OK
app --> cac : OK

== SPI Transceive (RID 0x0502) ==
cac -> app : SerialToSPIApp_Transceive(device, pTx, txLen, pRx, rxLen)
app -> app : Validate initialized
app -> drv : SpiMasterDriver_Transceive(device, pTx, txLen, pRx, rxLen)
drv --> app : OK + pRx filled
app --> cac : OK + received data

note over app
  CAC extracts device, data from
  RID payload and passes as typed params.
  Transceive result is returned to CAC
  which builds the RoutineControl response.
end note
@enduml