@startuml serialToSPIAppStaticStructure
skinparam backgroundColor #FEFEFE

package "serialToSPIApp" {
    interface ISerialToSPIApp {
        + Init() : Status_t
        + DeInit() : Status_t
        + Write(device, pData, length) : Status_t
        + Transceive(device, pTxData, txLength, pRxData, rxLength) : Status_t
    }

    class SerialToSPIApp_Context_t {
        - initialized: bool
    }

    ISerialToSPIApp --> SerialToSPIApp_Context_t : manages
}

package "layer1Driver" {
    interface ISpiMasterDriver {
        + SpiMasterDriver_Write(device, pData, len) : Status_t
        + SpiMasterDriver_Transceive(device, pTx, txLen, pRx, rxLen) : Status_t
    }
}

ISerialToSPIApp --> ISpiMasterDriver : delegates

note right of ISerialToSPIApp
  No UDS awareness.
  Called by CAC for:
  - RID 0x0500: Write(device, pData, length)
  - RID 0x0501: Transceive(device, pTxData, txLen, pRxData, rxLen)
end note
@enduml