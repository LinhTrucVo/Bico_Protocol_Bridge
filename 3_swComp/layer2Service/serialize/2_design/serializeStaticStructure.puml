@startuml serializeStaticStructure
skinparam backgroundColor #FEFEFE

package "serialize" {
    interface ISerialize {
        + Init() : Status_t
        + DeInit() : Status_t
        + BuildReadResponse(did, pData, dataLen, pResp) : Status_t
        + BuildWriteResponse(did, pResp) : Status_t
        + BuildRoutineResponse(routineControlType, rid, pStatusRecord, statusLen, pResp) : Status_t
        + BuildNegativeResponse(requestSid, nrc, pResp) : Status_t
    }

    class Serialize_Context_t {
        - initialized: bool
    }

    class Serialize_UdsResponse_t {
        + buffer[256]: uint8_t
        + length: uint16_t
    }

    ISerialize --> Serialize_Context_t : manages\n(static instance)
    ISerialize --> Serialize_UdsResponse_t : produces
}

note right of Serialize_UdsResponse_t
    Positive response format:
    ReadDataByIdentifier:  [0x62][DID_H][DID_L][data...]
    WriteDataByIdentifier: [0x6E][DID_H][DID_L]
    RoutineControl:        [0x71][routineControlType][RID_H][RID_L][statusRecord...]

    Negative response format:
    [0x7F][requestSID][NRC]
end note
@enduml