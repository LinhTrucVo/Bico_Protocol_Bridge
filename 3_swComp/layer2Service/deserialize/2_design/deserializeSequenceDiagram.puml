@startuml deserializeSequenceDiagram
participant "Central App Controller" as CAC
participant "Deserialize" as des
participant "Context" as ctx

CAC -> des : DeserializeUnit_Init()
des -> ctx : initialized = true
des --> CAC : DESERIALIZE_STATUS_OK

CAC -> des : DeserializeUnit_Parse(pFrame, pRequest)
des -> des : Check initialized
des -> des : Validate pFrame != NULL, pRequest != NULL
des -> des : Check frame.length >= MIN_FRAME_SIZE (3)
des -> des : Extract SID from pFrame->pData[0]

alt SID == 0x22 (ReadDataByIdentifier)
    des -> des : Decode DID = (byte[1] << 8) | byte[2]
    des -> des : pRequest->id = DID
    des -> des : No payload
else SID == 0x2E (WriteDataByIdentifier)
    des -> des : Check length >= 4
    des -> des : Decode DID = (byte[1] << 8) | byte[2]
    des -> des : pPayload = &byte[3], payloadLength = length - 3
else SID == 0x31 (RoutineControl)
    des -> des : Check length >= 4
    des -> des : routineControlType = byte[1]
    des -> des : Decode RID = (byte[2] << 8) | byte[3]
    des -> des : pPayload = &byte[4] (if length > 4)
else Unknown SID
    des --> CAC : DESERIALIZE_STATUS_UNSUPPORTED_SID
end

des --> CAC : DESERIALIZE_STATUS_OK + populated request
@enduml