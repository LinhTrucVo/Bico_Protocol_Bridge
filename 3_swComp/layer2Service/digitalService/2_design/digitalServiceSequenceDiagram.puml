@startuml DigitalServiceSequenceDiagram
participant "CAC" as cac
participant "DigitalService" as app
participant "GpioDriver" as gpio
participant "PwmDriver" as pwm

== GPIO Write (RID 0x0200) ==
cac -> app : DigitalService_WriteGpio(pin, state)
app -> gpio : GpioDriver_Write(pin, state)
gpio --> app : OK
app --> cac : OK

== GPIO Read (RID 0x0201) ==
cac -> app : DigitalService_ReadGpio(pin, &state)
app -> gpio : GpioDriver_Read(pin, &state)
gpio --> app : OK + state
app --> cac : OK

== PWM Start (RID 0x0300) ==
cac -> app : DigitalService_StartPwm(channel)
app -> pwm : PwmDriver_Start(channel)
pwm --> app : OK
app --> cac : OK

== PWM Stop (RID 0x0301) ==
cac -> app : DigitalService_StopPwm(channel)
app -> pwm : PwmDriver_Stop(channel)
pwm --> app : OK
app --> cac : OK
@enduml