@startuml I2cServiceStaticStructure
skinparam backgroundColor #FEFEFE

package "I2cService" {
    interface II2cService {
        + Init() : Status_t
        + DeInit() : Status_t
        + Write(address, pData, length) : Status_t
        + Read(address, pData, length) : Status_t
    }

    class I2cService_Context_t {
        - initialized: bool
    }

    II2cService --> I2cService_Context_t : manages
}

package "layer1Driver" {
    interface II2cMasterDriver {
        + I2cMasterDriver_Write(addr, pData, len) : Status_t
        + I2cMasterDriver_Read(addr, pData, len) : Status_t
    }
}

II2cService --> II2cMasterDriver : delegates

note right of II2cService
  Called by CAC for:
  - RID 0x0400: Write(address, pData, length)
  - RID 0x0401: Read(address, pData, length)
end note
@enduml