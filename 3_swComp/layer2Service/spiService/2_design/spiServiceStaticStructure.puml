@startuml SpiServiceStaticStructure
skinparam backgroundColor #FEFEFE

package "SpiService" {
    interface ISpiService {
        + Init() : Status_t
        + DeInit() : Status_t
        + Write(device, pData, length) : Status_t
        + Transceive(device, pTxData, txLength, pRxData, rxLength) : Status_t
    }

    class SpiService_Context_t {
        - initialized: bool
    }

    ISpiService --> SpiService_Context_t : manages
}

package "layer1Driver" {
    interface ISpiMasterDriver {
        + SpiMasterDriver_Write(device, pData, len) : Status_t
        + SpiMasterDriver_Transceive(device, pTx, txLen, pRx, rxLen) : Status_t
    }
}

ISpiService --> ISpiMasterDriver : delegates

note right of ISpiService
  Called by CAC for:
  - RID 0x0500: Write(device, pData, length)
  - RID 0x0501: Transceive(device, pTxData, txLen, pRxData, rxLen)
end note
@enduml